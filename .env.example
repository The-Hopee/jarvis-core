# Copy to .env locally. Never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
JARVIS_TTS=edge
JARVIS_VOICE=ru-RU-DmitryNeural
JARVIS_VOICE_PRESET=deep
# Optional tuning: JARVIS_TTS_RATE=-8% and JARVIS_TTS_PITCH=-18Hz
# Optional: correct an IP/VPN location by specifying your city or coordinates.
JARVIS_CITY=
JARVIS_LATITUDE=
JARVIS_LONGITUDE=
# JARVIS_MICROPHONE=3
# Telegram is detected automatically. Uncomment only to override its executable.
# JARVIS_TELEGRAM_PATH=C:\Users\you\AppData\Roaming\Telegram Desktop\Telegram.exe
# Telegram user-account API: create credentials at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Russian neural voice (requires setup-voice.ps1):
# JARVIS_TTS=silero
JARVIS_LOCAL_SPEAKER=aidar
# Optional separate OpenRouter models for coding-agent roles:
JARVIS_MASTER_MODEL=
JARVIS_WORKER_MODEL=
JARVIS_REVIEW_MODEL=
# Keep listening for a reply after speaking (0 disables follow-up listening):
JARVIS_CONVERSATION_SECONDS=40
# Local cached status clips; prepare once with --prepare-status-voice.
JARVIS_PROGRESS=1
JARVIS_PROGRESS_DELAY=0.8
# Local wake word + paid transcription of activated commands only:
JARVIS_ASR=vosk
JARVIS_ASR_MODEL=elevenlabs/scribe-v2
# Set JARVIS_ASR=openrouter to use the same OpenRouter key.
# Optional reference-conditioned speech through OpenRouter:
# JARVIS_TTS=openrouter
JARVIS_TTS_MODEL=fish-audio/s2.1-pro
JARVIS_TTS_VOICE=
JARVIS_VOICE_REFERENCE=
JARVIS_VOICE_REFERENCE_TEXT=
# Optional exact recorded responses, JSON {"samples":{"spoken phrase":"clip.wav"}}:
JARVIS_VOICE_SAMPLES=
# Alternative direct ElevenLabs backend (JARVIS_ASR/TTS=elevenlabs):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_ASR_MODEL=scribe_v2
# Only DOCX under these directories may be read/opened; separate roots with ;
# JARVIS_DOCUMENT_ROOTS=C:\Users\you\Documents
# Optional executable overrides; otherwise installed/running apps are discovered:
# JARVIS_VSCODE_PATH=C:\Users\you\AppData\Local\Programs\Microsoft VS Code\Code.exe
# JARVIS_ONLYOFFICE_PATH=C:\Program Files\ONLYOFFICE\DesktopEditors\DesktopEditors.exe
